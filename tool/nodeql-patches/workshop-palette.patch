+import 'package:nodeql/engine/block/block_node.dart';
+
+enum SqlPaletteCategory {
+  queryLanguage,
+  dataTypes,
+  dml,
+  ddl,
+  txn,
+  database,
+  plugins,
+}
+
+const sqlPaletteBlockTypes = <SqlPaletteCategory, List<BlockType>>{
+  SqlPaletteCategory.queryLanguage: [
+    BlockType.eventGreenFlag,
+    BlockType.sqlSelect,
+    BlockType.sqlFrom,
+    BlockType.sqlWhere,
+    BlockType.sqlAnd,
+    BlockType.sqlOr,
+    BlockType.sqlJoin,
+    BlockType.sqlGroupBy,
+    BlockType.sqlHaving,
+    BlockType.sqlOrderBy,
+    BlockType.sqlLimit,
+    BlockType.sqlCount,
+    BlockType.sqlSum,
+    BlockType.sqlAvg,
+    BlockType.sqlMin,
+    BlockType.sqlMax,
+    BlockType.sqlCase,
+    BlockType.sqlSubqueryIn,
+    BlockType.sqlUnion,
+    BlockType.sqlIntersect,
+    BlockType.sqlExcept,
+    BlockType.sqlWith,
+    BlockType.sqlValues,
+    BlockType.sqlExplain,
+  ],
+  SqlPaletteCategory.dml: [
+    BlockType.sqlInsert,
+    BlockType.sqlInsertOrReplace,
+    BlockType.sqlUpsert,
+    BlockType.sqlUpdate,
+    BlockType.sqlDelete,
+  ],
+  SqlPaletteCategory.ddl: [
+    BlockType.sqlCreateTable,
+    BlockType.sqlCreateIndex,
+    BlockType.sqlDropIndex,
+    BlockType.sqlCreateView,
+    BlockType.sqlDropView,
+    BlockType.sqlCreateTrigger,
+    BlockType.sqlDropTrigger,
+    BlockType.sqlCreateVirtualTable,
+    BlockType.sqlAlterTable,
+    // SQLite has no TRUNCATE; this block executes as DELETE FROM.
+    BlockType.sqlTruncate,
+    BlockType.sqlDropTable,
+  ],
+  SqlPaletteCategory.txn: [
+    BlockType.sqlBeginTransaction,
+    BlockType.sqlSavepoint,
+    BlockType.sqlRollbackToSavepoint,
+    BlockType.sqlReleaseSavepoint,
+    BlockType.sqlCommit,
+    BlockType.sqlEndTransaction,
+    BlockType.sqlRollback,
+  ],
+  SqlPaletteCategory.database: [
+    BlockType.sqlPragma,
+    BlockType.sqlAttachDatabase,
+    BlockType.sqlDetachDatabase,
+    BlockType.sqlVacuum,
+    BlockType.sqlReindex,
+    BlockType.sqlAnalyze,
+  ],
+};
+
+enum SqlPaletteLiteralType {
+  nullValue('null'),
+  integer('integer'),
+  real('real'),
+  text('text'),
+  blob('blob');
+
+  const SqlPaletteLiteralType(this.storageClass);
+
+  final String storageClass;
+
+  String get paletteKey => 'sqlite.datatype.$storageClass';
+}
+
+final sqlPaletteCardKeys = Set<String>.unmodifiable({
+  for (final types in sqlPaletteBlockTypes.values)
+    for (final type in types) type.name,
+  for (final type in SqlPaletteLiteralType.values) type.paletteKey,
+});
