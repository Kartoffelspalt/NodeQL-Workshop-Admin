+Map<String, LearningPathPaletteCue> decodeLearningPathPaletteCues(
+  Object? value,
+) {
+  if (value == null) return const {};
+  if (value is! Map) {
+    throw const FormatException('Invalid workshop palette cues.');
+  }
+  final cues = <String, LearningPathPaletteCue>{};
+  for (final entry in value.entries) {
+    final key = entry.key;
+    final cue = LearningPathPaletteCue.values
+        .where((cue) => cue.name == entry.value)
+        .firstOrNull;
+    if (key is! String || !sqlPaletteCardKeys.contains(key) || cue == null) {
+      throw const FormatException('Invalid workshop palette cue.');
+    }
+    cues[key] = cue;
+  }
+  return Map.unmodifiable(cues);
+}
